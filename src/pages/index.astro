---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Stack from "../components/Stack.astro";
import AboutMe from "../components/AboutMe.astro";
import Contact from "../components/Contact.astro";
---

<Layout title="Michael Taboada — Ingeniero de Sistemas y Ciencias de Datos">
  <main id="contenido">
    <Hero />

    <Section
      id="trayectoria"
      index="01 / Trayectoria"
      title="Dónde he trabajado y estudiado"
      note="Dos recorridos en paralelo: el trabajo de producto y la formación en ingeniería y datos."
    >
      <Experience />
    </Section>

    <Section
      id="proyectos"
      index="02 / Proyectos"
      title="Cosas que construí y qué resolvieron"
      note="Una selección. Cada caso incluye el problema, el enfoque y lo que quedó funcionando."
    >
      <Projects />
    </Section>

    <Section
      id="instrumental"
      index="03 / Instrumental"
      title="Con qué trabajo"
      note="Agrupado por la capa que resuelve, que es como se decide una herramienta."
    >
      <Stack />
    </Section>

    <Section
      id="sobre-mi"
      index="04 / Sobre mí"
      title="Cómo llegué hasta acá"
    >
      <AboutMe />
    </Section>

    <Contact />
  </main>
</Layout>
