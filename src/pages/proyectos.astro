---
import Layout from "../layouts/Layout.astro";
import ProjectCarousel from "../components/ProjectCarousel.astro";
import { getAllProjects } from "../data/projects";

const PROJECTS = getAllProjects();
---

<Layout
  title="Proyectos — Michael Taboada"
  description="Archivo completo de proyectos: producto, investigación, hackathones NASA Space Apps y trabajo académico."
>
  <main id="contenido" class="archive">
    <div class="shell">
      <a href="/" class="back">
        <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M12 7H2M6 3L2 7l4 4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="tele">Inicio</span>
      </a>

      <header class="archive-head">
        <p class="tele archive-index">Archivo · {PROJECTS.length} proyectos</p>
        <h1 class="archive-title display">Todo lo que he construido</h1>
        <p class="lede archive-lede">
          Producto en uso, investigación en machine learning, dos ediciones de
          NASA Space Apps y trabajo académico.
        </p>
      </header>

      <ProjectCarousel projects={PROJECTS} />
    </div>
  </main>
</Layout>

<style>
  .archive { padding-top: clamp(6rem, 4rem + 8vw, 9rem); padding-bottom: var(--gap-xl); }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--paper-3);
    transition: color 220ms ease;
  }

  /* Área táctil de dedo: el relleno crece y el margen lo compensa,
     así el diseño no se mueve y el toque llega a ~44px. */
  @media (pointer: coarse) {
    .back { padding-block: 0.85rem; margin-block: -0.85rem; }
  }

  .back:hover { color: var(--signal); }
  .back svg { width: 13px; height: 13px; transition: transform 300ms cubic-bezier(.16,1,.3,1); }
  .back:hover svg { transform: translateX(-3px); }
  .back .tele { color: inherit; }

  .archive-head {
    padding-block: var(--gap-lg) var(--gap-md);
    margin-bottom: var(--gap-lg);
    border-bottom: 1px solid var(--rule);
  }

  .archive-index { color: var(--signal); margin-bottom: 0.9rem; }

  .archive-title {
    font-size: var(--step-5);
    color: var(--paper);
  }

  .archive-lede { margin-top: var(--gap-md); max-width: 46ch; }

</style>
