---
import Layout from "../../layouts/Layout.astro";
import TagChip from "../../components/TagChip.astro";
import GithubIcon from "../../icons/GithubIcon.astro";
import { getAllProjects, ogSrc } from "../../data/projects";

export async function getStaticPaths() {
  const projects = getAllProjects();
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      index: i,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, index, prev, next } = Astro.props;

const escape = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const inline = (s: string) =>
  escape(s).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");

/*
  El texto largo se escribe en un Markdown mínimo (negritas, viñetas y
  encabezados de una línea). Se renderiza aquí en vez de encadenar reemplazos,
  para que las listas queden como listas y no como saltos de línea.
*/
function render(md: string): string {
  const out: string[] = [];
  let list: string[] = [];

  const flush = () => {
    if (!list.length) return;
    out.push(`<ul>${list.map((li) => `<li>${inline(li)}</li>`).join("")}</ul>`);
    list = [];
  };

  for (const raw of md.split("\n")) {
    const line = raw.trim();
    if (!line) {
      flush();
      continue;
    }
    if (line.startsWith("- ")) {
      list.push(line.slice(2));
      continue;
    }
    flush();
    const heading = line.match(/^\*\*(.+?):?\*\*:?$/);
    if (heading) {
      out.push(`<h3>${escape(heading[1])}</h3>`);
    } else {
      out.push(`<p>${inline(line)}</p>`);
    }
  }
  flush();
  return out.join("");
}

const body = project.longDescription ? render(project.longDescription) : "";
---

<Layout
  title={`${project.title} — Michael Taboada`}
  description={project.description}
  image={ogSrc(project.image)}
>
  <main id="contenido" class="case-page">
    <div class="shell">
      <a href="/proyectos" class="back">
        <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M12 7H2M6 3L2 7l4 4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="tele">Proyectos</span>
      </a>

      <header class="head">
        <p class="head-meta">
          <span class="tele head-num">{String(index + 1).padStart(2, "0")}</span>
          <span class="head-rule" aria-hidden="true"></span>
          <span class="tele">{project.context}</span>
        </p>

        <h1 class="head-title display">{project.title}</h1>
        <p class="lede head-lede">{project.description}</p>
      </header>

      <figure class="shot">
        <img
          src={project.image}
          alt={`Captura de ${project.title}`}
          width="1280"
          height="800"
          loading="eager"
        />
        <span class="bracket bracket--tl" aria-hidden="true"></span>
        <span class="bracket bracket--tr" aria-hidden="true"></span>
        <span class="bracket bracket--bl" aria-hidden="true"></span>
        <span class="bracket bracket--br" aria-hidden="true"></span>
      </figure>

      <div class="layout">
        <aside class="ficha">
          <div class="ficha-block">
            <h2 class="tele ficha-label">Stack</h2>
            <ul class="ficha-tags">
              {project.tags.map((t) => (
                <li><TagChip tag={t} size="sm" /></li>
              ))}
            </ul>
          </div>

          {(project.github || project.preview) && (
            <div class="ficha-block">
              <h2 class="tele ficha-label">Enlaces</h2>
              <ul class="ficha-links">
                {project.preview && (
                  <li>
                    <a href={project.preview} target="_blank" rel="noopener noreferrer">
                      <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                        <path d="M3.5 10.5L10.5 3.5M10.5 3.5H5.5M10.5 3.5v5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      Ver en vivo
                    </a>
                  </li>
                )}
                {project.github && (
                  <li>
                    <a href={project.github} target="_blank" rel="noopener noreferrer">
                      <GithubIcon class="ficha-icon" />
                      Código fuente
                    </a>
                  </li>
                )}
              </ul>
            </div>
          )}
        </aside>

        <div class="prose" set:html={body} />
      </div>

      <nav class="pager" aria-label="Otros proyectos">
        <a class="pager-item pager-item--prev" href={`/proyecto/${prev.slug}`}>
          <span class="tele">Anterior</span>
          <span class="pager-title">{prev.title}</span>
        </a>
        <a class="pager-item pager-item--next" href={`/proyecto/${next.slug}`}>
          <span class="tele">Siguiente</span>
          <span class="pager-title">{next.title}</span>
        </a>
      </nav>
    </div>
  </main>
</Layout>

<style>
  .case-page {
    padding-top: clamp(6rem, 4rem + 8vw, 9rem);
    padding-bottom: var(--gap-xl);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--paper-3);
    transition: color 220ms ease;
  }

  /* Área táctil de dedo: el relleno crece y el margen lo compensa,
     así el diseño no se mueve y el toque llega a ~44px. */
  @media (pointer: coarse) {
    .back, .ficha-links a { padding-block: 0.85rem; margin-block: -0.85rem; }
  }

  .back:hover { color: var(--signal); }
  .back svg { width: 13px; height: 13px; transition: transform 300ms cubic-bezier(.16,1,.3,1); }
  .back:hover svg { transform: translateX(-3px); }
  .back .tele { color: inherit; }

  /* --- Encabezado --- */
  .head { padding-block: var(--gap-lg) var(--gap-md); }

  .head-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .head-num { color: var(--signal); }
  .head-rule { width: 28px; height: 1px; background: var(--rule); }

  .head-title {
    font-size: var(--step-5);
    color: var(--paper);
    max-width: 20ch;
  }

  .head-lede { margin-top: var(--gap-md); max-width: 52ch; }

  /* --- Captura --- */
  .shot {
    position: relative;
    margin: var(--gap-lg) 0 0;
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow: hidden;
    background: var(--ink-3);
  }

  .shot img {
    width: 100%;
    height: auto;
    max-height: 74vh;
    object-fit: cover;
    object-position: top center;
  }

  .bracket {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--signal);
    pointer-events: none;
  }

  .bracket--tl { top: 12px; left: 12px;  border-right: 0; border-bottom: 0; }
  .bracket--tr { top: 12px; right: 12px; border-left: 0;  border-bottom: 0; }
  .bracket--bl { bottom: 12px; left: 12px;  border-right: 0; border-top: 0; }
  .bracket--br { bottom: 12px; right: 12px; border-left: 0; border-top: 0; }

  /* --- Cuerpo --- */
  .layout {
    display: grid;
    gap: var(--gap-lg);
    margin-top: var(--gap-xl);
  }

  @media (min-width: 880px) {
    .layout {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: clamp(2rem, 1rem + 4vw, 4rem);
      align-items: start;
    }
    .ficha { position: sticky; top: 6.5rem; }
  }

  .ficha-block + .ficha-block { margin-top: var(--gap-md); }

  .ficha-label {
    padding-bottom: 0.55rem;
    margin-bottom: 0.8rem;
    border-bottom: 1px solid var(--rule);
    color: var(--signal);
  }

  .ficha-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
  }

  .ficha-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .ficha-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--paper-2);
    transition: color 220ms ease;
  }

  .ficha-links a:hover { color: var(--signal); }
  .ficha-links svg,
  .ficha-links :global(.ficha-icon) { width: 13px; height: 13px; }

  /* --- Prosa del caso --- */
  .prose { max-width: 66ch; }

  .prose :global(p) {
    font-size: var(--step-0);
    color: var(--paper-2);
  }

  .prose :global(p + p) { margin-top: 1rem; }

  .prose :global(h3) {
    margin: var(--gap-lg) 0 0.9rem;
    padding-top: var(--gap-md);
    border-top: 1px solid var(--rule);
    font-family: var(--font-body);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--paper);
  }

  .prose :global(h3:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }

  .prose :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .prose :global(li) {
    position: relative;
    padding-left: 1.35rem;
    font-size: var(--step--1);
    color: var(--paper-2);
  }

  /* Viñeta como marca de escala, no como punto */
  .prose :global(li)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 8px;
    height: 1px;
    background: var(--signal);
  }

  .prose :global(strong) {
    font-weight: 500;
    color: var(--paper);
  }

  /* --- Paginación --- */
  .pager {
    display: grid;
    gap: 1px;
    margin-top: var(--gap-xl);
    border-top: 1px solid var(--rule);
    background: var(--rule);
  }

  @media (min-width: 640px) {
    .pager { grid-template-columns: 1fr 1fr; }
  }

  .pager-item {
    display: grid;
    gap: 0.4rem;
    padding: var(--gap-md) 0;
    background: var(--ink);
    transition: background-color 260ms ease;
  }

  .pager-item--next { text-align: right; }

  @media (min-width: 640px) {
    .pager-item { padding-inline: var(--gap-md); }
    .pager-item--prev { padding-left: 0; }
    .pager-item--next { padding-right: 0; }
  }

  .pager-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.15;
    color: var(--paper-2);
    transition: color 260ms ease;
  }

  .pager-item:hover .pager-title { color: var(--signal); }
</style>
