---
import ExperienceItem from "./ExperienceItem.astro";

/*
  El tipo (trabajo / formación) es información que el lector necesita para leer
  dos trayectorias que corren en paralelo, no un adorno.
*/
const EXPERIENCE = [
  {
    from: "2024",
    to: "Presente",
    kind: "trabajo",
    title: "Desarrollador Full Stack",
    company: "Zenoex",
    link: "https://zenoex.co",
    description:
      "Desarrollo de aplicaciones web de punta a punta con React, Next.js, Astro y Node.js. Interfaces responsivas y servicios que las sostienen.",
    stack: ["React", "Next.js", "Astro", "Node.js"],
  },
  {
    from: "Ago 2025",
    to: "Dic 2025",
    kind: "trabajo",
    title: "Intern, Professional Services",
    company: "Labvantage Latam",
    link: "https://www.labvantage.com",
    description:
      "Implementación y configuración de LIMS (Laboratory Information Management System) para clientes de la región.",
    stack: ["LIMS", "SQL", "Java"],
  },
  {
    from: "2024",
    to: "Presente",
    kind: "formación",
    title: "Doble titulación en Ciencias de Datos",
    company: "Universidad Tecnológica de Bolívar",
    link: "https://www.utb.edu.co",
    description:
      "Análisis de datos y machine learning aplicado a problemas reales, con Python, Pandas, NumPy y scikit-learn.",
    stack: ["Python", "Pandas", "scikit-learn"],
  },
  {
    from: "2021",
    to: "Dic 2025",
    kind: "formación",
    title: "Ingeniería de Sistemas y Computación",
    company: "Universidad Tecnológica de Bolívar",
    link: "https://www.utb.edu.co",
    description:
      "Título profesional. Proyectos académicos y personales en desarrollo web, bases de datos y arquitectura de software.",
    stack: ["Arquitectura", "Bases de datos", "Web"],
  },
];
---

<ol class="log">
  {
    EXPERIENCE.map((item, i) => (
      <ExperienceItem {...item} index={i} />
    ))
  }
</ol>

<style>
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
