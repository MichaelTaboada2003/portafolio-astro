---
import { TAGS } from "../data/projects";

/*
  Instrumental — la herramienta agrupada por el trabajo que hace, no por
  popularidad. Un lector técnico busca la capa, no la lista alfabética.
*/
const GROUPS = [
  {
    role: "Interfaz",
    note: "Lo que la persona toca",
    items: [TAGS.REACT, TAGS.NEXTJS, TAGS.ASTRO, TAGS.VUE, TAGS.TYPESCRIPT, TAGS.TAILWIND],
  },
  {
    role: "Servicio",
    note: "Lo que responde detrás",
    items: [TAGS.NODEJS, TAGS.FASTAPI, TAGS.FLASK, TAGS.SUPABASE, TAGS.POSTGRESQL],
  },
  {
    role: "Datos y modelos",
    note: "Lo que mide y decide",
    items: [TAGS.PYTHON, TAGS.SCIKIT, TAGS.OPENCV, TAGS.GROQ],
  },
  {
    role: "Entorno",
    note: "Dónde vive lo anterior",
    items: [TAGS.DOCKER, TAGS.AWS, TAGS.TERRAFORM, TAGS.EXPO],
  },
];
---

<div class="rack">
  {
    GROUPS.map((g, i) => (
      <section class="rack-group" data-reveal style={`--d:${i * 80}ms`}>
        <header class="rack-head">
          <h3 class="tele rack-role">{g.role}</h3>
          <p class="rack-note">{g.note}</p>
        </header>

        <ul class="rack-items">
          {g.items.map((t) => (
            <li class="rack-item" style={`--brand:${t.color ?? "currentColor"}`}>
              {t.icon ? (
                <t.icon class="rack-icon" />
              ) : (
                <span class="rack-icon rack-icon--blank" aria-hidden="true" />
              )}
              <span class="rack-name">{t.name}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .rack {
    display: grid;
    gap: 0;
  }

  .rack-group {
    display: grid;
    gap: var(--gap-sm);
    padding-block: var(--gap-md);
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 768px) {
    .rack-group {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--gap-md);
      align-items: start;
    }
  }

  .rack-role {
    color: var(--signal);
    letter-spacing: 0.16em;
  }

  .rack-note {
    margin-top: 0.3rem;
    font-size: var(--step--2);
    color: var(--paper-3);
  }

  .rack-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .rack-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.42rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    font-size: 0.82rem;
    color: var(--paper-2);
    background: transparent;
    transition:
      border-color 280ms ease,
      color 280ms ease,
      background-color 280ms ease,
      transform 280ms cubic-bezier(.16,1,.3,1);
  }

  .rack-item:hover {
    color: var(--paper);
    border-color: color-mix(in srgb, var(--brand) 50%, var(--rule));
    background: color-mix(in srgb, var(--brand) 8%, transparent);
    transform: translateY(-2px);
  }

  .rack-item :global(.rack-icon) {
    width: 15px;
    height: 15px;
    flex: none;
    opacity: 0.65;
    transition: opacity 280ms ease;
  }

  .rack-item:hover :global(.rack-icon) { opacity: 1; }

  /* Marcas sin icono conservan la ranura para que la fila no se descuadre */
  .rack-icon--blank {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--brand);
    margin-inline: 5px;
  }
</style>
