---
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="shell">
    <div class="foot-inner">
      <p class="tele">© {year} Michael Taboada</p>
      <span class="foot-rule ticks" aria-hidden="true"></span>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: auto;
    padding-block: var(--gap-md) var(--gap-lg);
    border-top: 1px solid var(--rule);
  }

  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .foot-rule {
    flex: 1;
    min-width: 2rem;
    opacity: 0.6;
  }
</style>
