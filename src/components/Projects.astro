---
import { getFeaturedProjects, cardSrc } from "../data/projects";
import GithubIcon from "../icons/GithubIcon.astro";
import TagChip from "./TagChip.astro";

const FEATURED = getFeaturedProjects();
---

<div class="work">
  {
    FEATURED.map((p, i) => (
      <article class="case" data-reveal style={`--d:${i * 80}ms`}>
        <a
          class="case-shot"
          href={`/proyecto/${p.slug}`}
          aria-label={`Ver detalles de ${p.title}`}
        >
          <img src={cardSrc(p.image)} alt="" loading="lazy" width="1040" height="650" />
          <span class="bracket bracket--tl" aria-hidden="true" />
          <span class="bracket bracket--tr" aria-hidden="true" />
          <span class="bracket bracket--bl" aria-hidden="true" />
          <span class="bracket bracket--br" aria-hidden="true" />
        </a>

        <div class="case-body">
          <p class="case-meta">
            <span class="tele case-index">{String(i + 1).padStart(2, "0")}</span>
            <span class="case-meta-rule" aria-hidden="true" />
            <span class="tele case-context">{p.context}</span>
          </p>

          <h3 class="case-title">
            <a href={`/proyecto/${p.slug}`}>{p.title}</a>
          </h3>

          <p class="case-text">{p.description}</p>

          <ul class="case-tags">
            {p.tags.map((t) => (
              <li>
                <TagChip tag={t} />
              </li>
            ))}
          </ul>

          <div class="case-links">
            <a class="case-cta" href={`/proyecto/${p.slug}`}>
              Ver el caso
              <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M2 7h10M8 3l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            {p.github && (
              <a class="case-alt" href={p.github} target="_blank" rel="noopener noreferrer">
                <GithubIcon class="case-alt-icon" />
                Código
              </a>
            )}
            {p.preview && (
              <a class="case-alt" href={p.preview} target="_blank" rel="noopener noreferrer">
                <svg class="case-alt-icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                  <path d="M3.5 10.5L10.5 3.5M10.5 3.5H5.5M10.5 3.5v5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                En vivo
              </a>
            )}
          </div>
        </div>
      </article>
    ))
  }

  <a href="/proyectos" class="work-more">
    <span class="tele">Archivo completo</span>
    <span class="work-more-line" aria-hidden="true"></span>
    <span class="work-more-label">Ver los 8 proyectos</span>
    <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M2 7h10M8 3l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</div>

<style>
  .work {
    display: grid;
    gap: var(--gap-xl);
  }

  .case {
    display: grid;
    gap: var(--gap-md);
    align-items: center;
  }

  @media (min-width: 880px) {
    .case {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: clamp(2rem, 1rem + 4vw, 3.5rem);
    }
    /* Alternancia: la imagen cambia de lado y el ojo no se acomoda */
    .case:nth-child(even) .case-shot { order: 2; }
  }

  /* --- Captura, montada como en la placa del retrato --- */
  .case-shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--ink-3);
  }

  .case-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    opacity: 0.92;
    transition: transform 900ms cubic-bezier(.16,1,.3,1), opacity 500ms ease;
  }

  .case-shot:hover img,
  .case-shot:focus-visible img {
    transform: scale(1.035);
    opacity: 1;
  }

  .bracket {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 1px solid var(--signal);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease, inset 400ms cubic-bezier(.16,1,.3,1);
  }

  .bracket--tl { top: 10px; left: 10px;  border-right: 0; border-bottom: 0; }
  .bracket--tr { top: 10px; right: 10px; border-left: 0;  border-bottom: 0; }
  .bracket--bl { bottom: 10px; left: 10px;  border-right: 0; border-top: 0; }
  .bracket--br { bottom: 10px; right: 10px; border-left: 0;  border-top: 0; }

  .case-shot:hover .bracket,
  .case-shot:focus-visible .bracket { opacity: 1; }

  /* --- Texto --- */
  .case-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
  }

  .case-index {
    color: var(--signal);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }

  .case-meta-rule {
    width: 28px;
    height: 1px;
    background: var(--rule);
  }

  .case-context { color: var(--paper-3); }

  .case-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.06;
    letter-spacing: -0.018em;
    color: var(--paper);
  }

  .case-title a {
    background-image: linear-gradient(var(--signal), var(--signal));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 420ms cubic-bezier(.16,1,.3,1), color 300ms ease;
  }

  .case-title a:hover { background-size: 100% 1px; }

  .case-text {
    margin-top: 0.85rem;
    font-size: var(--step--1);
    color: var(--paper-2);
    max-width: 52ch;
  }

  .case-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: var(--gap-md) 0 0;
    padding: 0;
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: var(--gap-md);
  }

  .case-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--signal);
  }

  /* Área táctil de dedo: el relleno crece y el margen lo compensa,
     así el diseño no se mueve y el toque llega a ~44px. */
  @media (pointer: coarse) {
    .case-cta, .case-alt { padding-block: 0.85rem; margin-block: -0.85rem; }
  }

  .case-cta svg { width: 13px; height: 13px; transition: transform 320ms cubic-bezier(.16,1,.3,1); }
  .case-cta:hover svg { transform: translateX(4px); }

  .case-alt {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-3);
    transition: color 220ms ease;
  }

  .case-alt:hover { color: var(--paper); }
  .case-alt :global(.case-alt-icon) { width: 13px; height: 13px; }

  /* --- Enlace al archivo --- */
  .work-more {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: var(--gap-md);
    border-top: 1px solid var(--rule);
    color: var(--paper-2);
    transition: color 260ms ease;
  }

  .work-more:hover { color: var(--signal); }

  .work-more-line {
    flex: 1;
    height: 1px;
    background: var(--rule);
    transition: background-color 260ms ease;
  }

  .work-more:hover .work-more-line { background: currentColor; }

  .work-more-label {
    font-size: var(--step-1);
    font-family: var(--font-display);
    letter-spacing: -0.01em;
  }

  .work-more svg {
    width: 15px;
    height: 15px;
    transition: transform 320ms cubic-bezier(.16,1,.3,1);
  }

  .work-more:hover svg { transform: translateX(5px); }
</style>
