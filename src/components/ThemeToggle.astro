---
// Alterna el tema. El icono es un disco que gira: sol de un lado, luna del otro.
---

<button
  id="theme-toggle"
  class="toggle"
  type="button"
  role="switch"
  aria-checked="true"
  aria-label="Cambiar a tema claro"
  data-theme="dark"
>
  <span class="toggle-disc">
    <svg class="toggle-face toggle-face--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M5.9 5.9l1.6 1.6M16.5 16.5l1.6 1.6M18.1 5.9l-1.6 1.6M7.5 16.5l-1.6 1.6"></path>
    </svg>
    <svg class="toggle-face toggle-face--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.5 13.2A8.4 8.4 0 1 1 10.8 3.5a6.6 6.6 0 0 0 9.7 9.7Z"></path>
    </svg>
  </span>
</button>

<style>
  .toggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--paper-2);
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease,
      background-color 200ms ease;
  }

  @media (pointer: coarse) {
    .toggle { width: 44px; height: 44px; }
  }

  .toggle:hover {
    color: var(--signal);
    border-color: color-mix(in srgb, var(--signal) 40%, transparent);
    background: color-mix(in srgb, var(--signal) 10%, transparent);
  }

  /* El disco rota 180°: una cara entra mientras la otra sale */
  .toggle-disc {
    position: relative;
    display: block;
    width: 17px;
    height: 17px;
    transform-style: preserve-3d;
    transition: transform 520ms cubic-bezier(.65,0,.35,1);
  }

  .toggle[data-theme="light"] .toggle-disc {
    transform: rotateY(180deg);
  }

  .toggle-face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
  }

  .toggle-face--moon {
    transform: rotateY(180deg);
  }
</style>
