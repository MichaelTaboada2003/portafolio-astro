---
// ThemeToggle.astro — Sin props, componente autónomo de alternancia de tema
---

<button
  id="theme-toggle"
  class="theme-toggle"
  role="switch"
  aria-checked="true"
  aria-label="Cambiar a tema claro"
  title="Cambiar tema"
>
  <!-- Icono sol: visible cuando el tema oscuro está activo (clic para cambiar a claro) -->
  <svg
    id="sun-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>

  <!-- Icono luna: visible cuando el tema claro está activo (clic para cambiar a oscuro) -->
  <svg
    id="moon-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    style="display: none;"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem;
    background: color-mix(in srgb, var(--color-surface) 85%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    color: var(--color-text);
    cursor: pointer;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: var(--shadow-card);
    transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
  }

  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle {
      transition: color 150ms ease, background-color 150ms ease, transform 200ms ease;
    }

    .theme-toggle:hover {
      transform: scale(1.1);
    }
  }
</style>
