---
const { href, ...rest } = Astro.props;
const external = !href?.startsWith("mailto:");
---

<a
  class="pill"
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  {...rest}
>
  <span class="pill-body"><slot /></span>
  <svg class="pill-arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
    <path d="M3 9L9 3M9 3H4M9 3v5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</a>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.8rem 0.5rem 0.9rem;
    min-height: 40px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    transition:
      color 240ms ease,
      border-color 240ms ease,
      background-color 240ms ease,
      transform 240ms cubic-bezier(.16,1,.3,1);
  }

  @media (pointer: coarse) {
    .pill { min-height: 44px; }
  }

  .pill-body {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pill :global(.pill-icon) {
    width: 15px;
    height: 15px;
  }

  .pill-arrow {
    width: 11px;
    height: 11px;
    opacity: 0;
    transform: translate(-4px, 3px);
    transition: opacity 240ms ease, transform 240ms cubic-bezier(.16,1,.3,1);
  }

  .pill:hover,
  .pill:focus-visible {
    color: var(--signal);
    border-color: color-mix(in srgb, var(--signal) 45%, transparent);
    background: color-mix(in srgb, var(--signal) 9%, transparent);
    transform: translateY(-2px);
  }

  .pill:hover .pill-arrow,
  .pill:focus-visible .pill-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }
</style>
