---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { title: "Trayectoria", label: "trayectoria", url: "/#trayectoria" },
  { title: "Proyectos", label: "proyectos", url: "/#proyectos" },
  { title: "Instrumental", label: "instrumental", url: "/#instrumental" },
  { title: "Sobre mí", label: "sobre-mi", url: "/#sobre-mi" },
];
---

<header class="dock-wrap">
  <div class="dock">
    <a href="/#inicio" class="dock-mark" aria-label="Inicio">
      <span class="dock-mark-glyph">MT</span>
    </a>

    <span class="dock-sep" aria-hidden="true"></span>

    <nav class="dock-nav" aria-label="Secciones">
      <span class="dock-pill" id="dock-pill" aria-hidden="true"></span>
      {
        navItems.map((link) => (
          <a class="dock-link" data-section={link.label} href={link.url}>
            {link.title}
          </a>
        ))
      }
    </nav>

    <span class="dock-sep" aria-hidden="true"></span>

    <button
      class="dock-menu"
      id="dock-menu"
      type="button"
      aria-expanded="false"
      aria-controls="dock-panel"
      aria-label="Abrir el índice"
    >
      <span class="dock-menu-ticks" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>

    <ThemeToggle />
  </div>

  <nav class="panel" id="dock-panel" aria-label="Índice" hidden>
    {
      [...navItems, { title: "Contacto", label: "contacto", url: "/#contacto" }].map(
        (link) => (
          <a class="panel-link" href={link.url} data-section={link.label}>
            <span class="tele panel-mark" aria-hidden="true" />
            {link.title}
          </a>
        ),
      )
    }
  </nav>
</header>

<script>
  function initDock() {
    const pill = document.getElementById("dock-pill");
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".dock-link"),
    );
    if (!pill || links.length === 0) return;

    let active: HTMLAnchorElement | null = null;

    const movePill = (el: HTMLAnchorElement | null) => {
      if (!el) {
        pill.style.opacity = "0";
        return;
      }
      pill.style.opacity = "1";
      pill.style.width = `${el.offsetWidth}px`;
      pill.style.transform = `translateX(${el.offsetLeft}px)`;
    };

    const setActive = (label: string | null) => {
      const match = label
        ? links.find((l) => l.dataset.section === label) ?? null
        : null;
      if (match === active) return;
      active = match;
      links.forEach((l) => l.classList.toggle("is-active", l === match));
      movePill(match);
    };

    // Hover previsualiza el destino; al salir vuelve a la sección real
    links.forEach((l) => {
      l.addEventListener("pointerenter", () => movePill(l));
      l.addEventListener("focus", () => movePill(l));
    });
    const nav = document.querySelector(".dock-nav");
    nav?.addEventListener("pointerleave", () => movePill(active));

    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    if (sections.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible) setActive(visible.target.id);
        },
        { rootMargin: "-20% 0px -60% 0px", threshold: [0, 0.25, 0.5, 1] },
      );
      sections.forEach((s) => observer.observe(s));
    }

    // Índice desplegable: por debajo de 720px el dock no cabe con los enlaces
    const menu = document.getElementById("dock-menu");
    const panel = document.getElementById("dock-panel");

    const closePanel = () => {
      if (!menu || !panel) return;
      menu.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-label", "Abrir el índice");
      panel.hidden = true;
    };

    menu?.addEventListener("click", () => {
      const open = menu.getAttribute("aria-expanded") === "true";
      if (open) return closePanel();
      menu.setAttribute("aria-expanded", "true");
      menu.setAttribute("aria-label", "Cerrar el índice");
      panel!.hidden = false;
    });

    panel?.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) closePanel();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closePanel();
    });

    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (!t.closest("#dock-panel") && !t.closest("#dock-menu")) closePanel();
    });

    // El dock se compacta al alejarse del inicio
    const dock = document.querySelector(".dock");
    const onScroll = () => dock?.classList.toggle("is-lifted", window.scrollY > 40);
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => movePill(active), { passive: true });
    onScroll();
  }

  document.addEventListener("astro:page-load", initDock);
</script>

<style>
  .dock-wrap {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: flex;
    justify-content: center;
    padding: 0.9rem 1rem;
    pointer-events: none;
  }

  .dock-wrap > .panel { pointer-events: auto; }

  .dock {
    position: relative;
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem;
    border-radius: 999px;
  }

  /* El cristal es una capa propia: solo se anima su opacidad, que el
     compositor resuelve sin repintar el dock entero. */
  .dock::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--glass);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-2);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    opacity: 0;
    transition: opacity 320ms ease;
  }

  .dock.is-lifted::before { opacity: 1; }

  .dock > * { position: relative; z-index: 1; }

  /* Monograma */
  .dock-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink);
    background: var(--signal);
    transition: transform 250ms cubic-bezier(.16,1,.3,1);
  }

  .dock-mark:hover { transform: rotate(-8deg) scale(1.06); }

  .dock-sep {
    width: 1px;
    height: 18px;
    background: var(--rule);
    opacity: 0;
    transition: opacity 350ms ease;
  }

  .dock.is-lifted .dock-sep { opacity: 1; }

  /* Navegación con píldora deslizante */
  .dock-nav {
    position: relative;
    display: none;
    align-items: center;
  }

  @media (min-width: 720px) {
    .dock-nav { display: flex; }
  }

  .dock-pill {
    position: absolute;
    inset-block: 3px;
    left: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--signal) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--signal) 28%, transparent);
    opacity: 0;
    transition:
      transform 420ms cubic-bezier(.16,1,.3,1),
      width 420ms cubic-bezier(.16,1,.3,1),
      opacity 250ms ease;
  }

  .dock-link {
    position: relative;
    z-index: 1;
    padding: 0.5rem 0.9rem;
    font-size: 0.83rem;
    font-weight: 500;
    color: var(--paper-2);
    white-space: nowrap;
    transition: color 200ms ease;
  }

  .dock-link:hover { color: var(--paper); }
  .dock-link.is-active { color: var(--signal); }

  /* --- Índice móvil --- */
  .dock-menu {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--paper-2);
    cursor: pointer;
    transition: color 200ms ease, border-color 200ms ease;
  }

  @media (min-width: 720px) {
    .dock-menu { display: none; }
  }

/* En pantallas de dedo los tres controles del dock llegan a 44px */
  @media (pointer: coarse) {
    .dock-mark, .dock-menu { width: 44px; height: 44px; }
  }

  .dock-menu:hover,
  .dock-menu[aria-expanded="true"] {
    color: var(--signal);
    border-color: color-mix(in srgb, var(--signal) 40%, transparent);
  }

  /* Las tres líneas son marcas de escala, no un hamburger genérico */
  .dock-menu-ticks {
    display: grid;
    gap: 3px;
    width: 15px;
  }

  .dock-menu-ticks span {
    display: block;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition: width 300ms cubic-bezier(.16,1,.3,1);
  }

  .dock-menu-ticks span:nth-child(1) { width: 100%; }
  .dock-menu-ticks span:nth-child(2) { width: 62%; }
  .dock-menu-ticks span:nth-child(3) { width: 84%; }

  .dock-menu[aria-expanded="true"] .dock-menu-ticks span { width: 100%; }

  .panel {
    pointer-events: auto;
    position: absolute;
    top: calc(100% - 0.4rem);
    left: 1rem;
    right: 1rem;
    display: grid;
    padding: 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--glass);
    box-shadow: var(--shadow-3);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    animation: panel-in 260ms cubic-bezier(.16,1,.3,1);
  }

  @keyframes panel-in {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: none; }
  }

  /* `display: grid` gana sobre el `display:none` que el agente de usuario
     aplica a [hidden]: hay que reponerlo explícitamente. */
  .panel[hidden] { display: none; }

  @media (min-width: 720px) {
    .panel { display: none; }
  }

  .panel-link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0.8rem;
    border-radius: 9px;
    font-size: 0.95rem;
    color: var(--paper-2);
    transition: color 200ms ease, background-color 200ms ease;
  }

  .panel-link:hover,
  .panel-link:focus-visible {
    color: var(--signal);
    background: color-mix(in srgb, var(--signal) 10%, transparent);
  }

  .panel-mark {
    width: 12px;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
    flex: none;
  }
</style>
