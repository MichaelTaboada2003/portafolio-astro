---
export interface Props {
  from: string;
  to: string;
  kind: string;
  title: string;
  company: string;
  description: string;
  link?: string;
  stack?: string[];
  index?: number;
}

const { from, to, kind, title, company, description, link, stack = [], index = 0 } =
  Astro.props;
const current = to.toLowerCase() === "presente";
---

<li class="row" data-reveal style={`--d:${index * 70}ms`}>
  <span class="row-edge" aria-hidden="true"></span>

  <div class="row-when">
    <p class="tele row-dates">
      {from}<span class="row-dash">—</span>{to}
      {current && <span class="row-live" aria-label="en curso"></span>}
    </p>
    <p class={`row-kind row-kind--${kind === "trabajo" ? "work" : "study"}`}>
      {kind}
    </p>
  </div>

  <div class="row-what">
    <h3 class="row-title">{title}</h3>
    {
      link ? (
        <a href={link} target="_blank" rel="noopener noreferrer" class="row-org">
          {company}
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M3 9L9 3M9 3H4M9 3v5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ) : (
        <p class="row-org">{company}</p>
      )
    }
    <p class="row-text">{description}</p>
    {
      stack.length > 0 && (
        <ul class="row-stack">
          {stack.map((s) => (
            <li class="tele">{s}</li>
          ))}
        </ul>
      )
    }
  </div>
</li>

<style>
  .row {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding-block: var(--gap-md);
    border-bottom: 1px solid var(--rule);
    transition: background-color 300ms ease;
  }

  @media (min-width: 768px) {
    .row {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--gap-md);
    }
  }

  /* Segmento vivo en el borde: sustituye al punto de una línea de tiempo.
     Marca el tramo que estás leyendo, en la misma lengua que el riel. */
  .row-edge {
    position: absolute;
    left: 0;
    top: -1px;
    width: 2px;
    height: 0;
    background: var(--signal);
    transition: height 420ms cubic-bezier(.16,1,.3,1);
  }

  @media (min-width: 768px) {
    .row-edge { left: -1.25rem; }
  }

  .row:hover .row-edge,
  .row:focus-within .row-edge {
    height: calc(100% + 1px);
  }

  /* --- Columna de tiempo --- */
  .row-dates {
    display: flex;
    align-items: center;
    color: var(--paper-2);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .row-dash {
    margin-inline: 0.35em;
    opacity: 0.4;
  }

  .row-live {
    width: 5px;
    height: 5px;
    margin-left: 0.5rem;
    border-radius: 999px;
    background: var(--reading);
    flex: none;
  }

  .row-kind {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    display: inline-block;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    width: fit-content;
  }

  .row-kind--work {
    color: var(--signal);
    background: color-mix(in srgb, var(--signal) 12%, transparent);
  }

  .row-kind--study {
    color: var(--paper-2);
    background: color-mix(in srgb, var(--paper-2) 10%, transparent);
  }

  /* --- Columna de contenido --- */
  .row-title {
    font-size: var(--step-1);
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--paper);
    line-height: 1.25;
  }

  .row-org {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.2rem;
    font-size: var(--step--1);
    color: var(--paper-2);
    transition: color 200ms ease;
  }

  .row-org svg {
    width: 10px;
    height: 10px;
    opacity: 0;
    transform: translate(-3px, 2px);
    transition: opacity 220ms ease, transform 220ms cubic-bezier(.16,1,.3,1);
  }

  /* Área táctil de dedo: el relleno crece y el margen lo compensa,
     así el diseño no se mueve y el toque llega a ~44px. */
  @media (pointer: coarse) {
    a.row-org { padding-block: 0.75rem; margin-block: -0.75rem; }
  }

  a.row-org:hover { color: var(--signal); }
  a.row-org:hover svg { opacity: 1; transform: none; }

  .row-text {
    margin-top: 0.7rem;
    font-size: var(--step--1);
    color: var(--paper-2);
    max-width: 62ch;
  }

  .row-stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.9rem 0 0;
    padding: 0;
  }

  .row-stack li {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--paper-3);
    transition: border-color 260ms ease, color 260ms ease;
  }

  .row:hover .row-stack li {
    border-color: color-mix(in srgb, var(--signal) 26%, var(--rule));
    color: var(--paper-2);
  }
</style>
